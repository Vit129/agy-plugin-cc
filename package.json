{
  "name": "@vit129/agy-plugin-cc",
  "version": "1.5.1",
  "description": "Claude Code plugin installer and updater for the Antigravity agy companion.",
  "type": "module",
  "files": [
    ".claude-plugin/marketplace.json",
    ".claude-plugin/plugin.json",
    "plugins/agy"
  ],
  "scripts": {
    "start": "bash scripts/release.sh",
    "check": "node --check plugins/agy/scripts/agy-companion.mjs && node --check plugins/agy/scripts/lib/git-update-check.mjs && node --check plugins/agy/scripts/session-lifecycle-hook.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
